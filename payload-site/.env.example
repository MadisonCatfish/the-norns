# Payload CMS Secret Key
PAYLOAD_SECRET=your-super-secret-random-key-at-least-32-chars

# Database Configuration
# For SQLite (default, persistent volume):
DATABASE_URI=file:./payload.db

# Cloudflare Pages Jamstack Deploy Hook
# (From Cloudflare Dashboard -> Workers & Pages -> the-norns -> Settings -> Builds & deployments -> Deploy hooks)
CLOUDFLARE_DEPLOY_HOOK=https://api.cloudflare.com/client/v4/pages/projects/the-norns/deployments

# Production Public Site URL & Admin URL
NEXT_PUBLIC_SERVER_URL=https://admin.the-norns.com
SITE_URL=http://localhost:3000
